<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="AppChofer.Views.MainView"
             Background="#EEF2EF">

    <Grid Name="RootShell" RowDefinitions="Auto, Auto, *" Background="#EEF2EF">
        
        <!-- 1. SELECTOR DE ROL Y TEMA -->
        <Grid Grid.Row="0" Margin="20,20,20,5" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <Border Name="RoleSwitch" Grid.Column="0" Background="#B8FFFFFF" CornerRadius="20" Padding="4">
                <Grid ColumnDefinitions="*,*">
                <Button Name="BtnTabChofer" Grid.Column="0" Click="OnTabChoferClick" Background="Transparent" BorderThickness="0" Foreground="#6E7D79" CornerRadius="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="👤" FontSize="14"/>
                        <TextBlock Text="Chofer" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                
                <Button Name="BtnTabUsuario" Grid.Column="1" Click="OnTabUsuarioClick" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Foreground="#267768" CornerRadius="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="👤" FontSize="14"/>
                        <TextBlock Text="Usuario" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                </Grid>
            </Border>

            <Button Name="ThemeToggle" Grid.Column="1" Click="OnThemeToggleClick" Margin="10,0,0,0" Width="54" Height="54" Background="#B8FFFFFF" BorderBrush="#1420312E" BorderThickness="1" CornerRadius="16" ToolTip.Tip="Cambiar tema claro u oscuro">
                <TextBlock Name="ThemeIcon" Text="☾" Foreground="#267768" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- 2. TÍTULOS DINÁMICOS -->
        <StackPanel Grid.Row="1" Margin="20,15,20,10">
            <TextBlock Name="TxtTitulo" Text="UNIDAD EN CAMINO" Foreground="#267768" FontWeight="Bold" FontSize="10" LetterSpacing="1.5"/>
            <!-- Contenedor elegante para el estado del GPS -->
        <Border Name="StatusCard" Background="#C7FFFFFF" 
                CornerRadius="10" 
                Padding="15,8" 
                Margin="0,10,0,15" 
                HorizontalAlignment="Center"
                BoxShadow="0 4 8 0 #40000000">
            
            <TextBlock Name="TxtSubtitulo" 
                       Text="Iniciando red..." 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Foreground="#267768" 
                       TextAlignment="Center"/>
        </Border>
        </StackPanel>

        <!-- 3. CONTENEDOR DE VISTAS -->
        <Grid Grid.Row="2" Margin="20,10,20,40" VerticalAlignment="Top">
            
            <!-- VISTA 1: PASAJERO (Mapa Limpio) -->
            <Border Name="PanelUsuario" IsVisible="True" CornerRadius="25" ClipToBounds="True" Background="#FFFFFF" BorderBrush="#E5ECE9" BorderThickness="1" Height="420">
                <mapsui:MapControl Name="MapaControl" />
            </Border>

            <!-- VISTA 2: CHOFER -->
            <Border Name="PanelChofer" IsVisible="False" Background="#FFFFFF" CornerRadius="25" Padding="25" Height="420">
                <Grid>
                    <!-- Contenido real del chofer -->
                    <StackPanel Name="ContenidoChofer" IsVisible="False" VerticalAlignment="Center" Spacing="25">
                        <TextBlock Name="ChoferPanelTitle" Text="PANEL DE TRANSMISIÓN GPS" Foreground="#6E7D79" FontSize="12" FontWeight="Bold" LetterSpacing="1" HorizontalAlignment="Center"/>
                        
                        <Button Name="BtnRuta" 
                                Content="INICIAR RUTA" 
                                Click="OnBtnRutaClick"
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                Background="#267768" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="18" 
                                Padding="20" 
                                CornerRadius="15"/>
                                
                        <Border Name="GpsCard" Background="#B8FFFFFF" CornerRadius="12" Padding="15">
                            <TextBlock Name="TxtGps" 
                                       Text="Ruta detenida. GPS inactivo." 
                                       Foreground="#267768" 
                                       HorizontalAlignment="Center" 
                                       FontSize="12" 
                                       FontFamily="Monospace"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- CAPA PROTECTORA DE ADVERTENCIA Y PIN -->
                    <Border Name="CapaPin" Background="#D6FFFFFF" CornerRadius="20" Padding="20" VerticalAlignment="Center">
                        <StackPanel Spacing="15" VerticalAlignment="Center">
                            <TextBlock Text="🔒 ACCESO RESTRINGIDO" 
                                       Foreground="#EF4444" 
                                       FontWeight="Black" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Name="PinDescription" Text="Esta opción solo está disponible para el conductor del transporte, en caso de serlo ponga el pin que se le dió." 
                                       Foreground="#6E7D79" 
                                       FontSize="12" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center"/>
                            
                            <TextBox Name="TxtBoxPin" 
                                     Watermark="Ingrese el PIN" 
                                     PasswordChar="*" 
                                     MaxLength="20"
                                     HorizontalContentAlignment="Center"
                                     Background="#B8FFFFFF"
                                     Foreground="#20312E"
                                     BorderBrush="#D8E2DE"
                                     CornerRadius="8"
                                     Padding="10"/>
                            
                            <Button Name="BtnVerificarPin" Content="VERIFICAR PIN" 
                                    Click="OnVerificarPinClick"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="#267768"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    CornerRadius="8"
                                    Padding="10"/>
                            
                            <TextBlock Name="TxtErrorPin" 
                                       Text="" 
                                       Foreground="#EF4444" 
                                       FontSize="11" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
</UserControl>